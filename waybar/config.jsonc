{
    "layer": "top",
    "position": "top",
    "margin-top": 4,
    "margin-bottom": 0,
    "margin-left": 6,
    "margin-right": 6,
    "spacing": 0,
    
    "modules-left": [],
    "modules-center": [
        "custom/power", 
        "clock", 
        "hyprland/workspaces", 
        "network", 
        "battery", 
        "custom/music"
    ],
    "modules-right": [],

    "battery": {
        "states": { "good": 95, "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": ["", "", "", "", ""]
    },

    "custom/music": {
        "format": "{}",
        "exec": "if [ \"$(playerctl status 2>/dev/null)\" = \"Playing\" ]; then echo ''; elif [ \"$(playerctl status 2>/dev/null)\" = \"Paused\" ]; then echo ''; else echo ''; fi",
        "on-click": "playerctl play-pause",
        "interval": 1,
        "tooltip": false,
        "max-length": 35
    },

    "clock": {
        "format": "  {:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}",
        "persistent-workspaces": { "1": [], "2": [], "3": [], "4": [] }
    },

    "network": {
        "format": "{icon}",
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤠", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "on-click": "kitty nmtui"
    },

    "custom/power": {
        "format": "",
        "on-click": "wlogout",
        "tooltip": false
    }
}
